# Public TLS endpoint. DNS must resolve this hostname to the deployment host.
CONTINUITY_ENV_FILE=.env.production
CONTINUITY_DOMAIN=continuity.example.com
ACME_EMAIL=operator@example.com

# PostgreSQL. Generate unique values in the deployment secret store.
POSTGRES_DB=continuity
POSTGRES_USER=continuity
POSTGRES_PASSWORD=REPLACE_WITH_SECRET

# Application
LOG_LEVEL=info
SHUTDOWN_TIMEOUT_MS=10000
HTTP_HEADERS_TIMEOUT_MS=15000
HTTP_REQUEST_TIMEOUT_MS=30000
HTTP_KEEP_ALIVE_TIMEOUT_MS=5000
# Keep empty when frontend and API share CONTINUITY_DOMAIN.
CORS_ALLOWED_ORIGINS=
CONTINUITY_OPERATOR_TOKEN=REPLACE_WITH_INDEPENDENT_SECRET
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120
MEMORY_ENABLED=true
SIBYL_MCP_COMMAND=sibyl-memory-mcp
SIBYL_CALL_TIMEOUT_MS=30000

# Virtuals ACP. Required for live agent execution.
VIRTUALS_ENABLED=false
VIRTUALS_WALLET_ADDRESS=
VIRTUALS_WALLET_ID=
VIRTUALS_SIGNER_PRIVATE_KEY=
VIRTUALS_BUILDER_CODE=
VIRTUALS_CHAIN_ID=8453
VIRTUALS_MAX_JOB_USDC=1
VIRTUALS_POLL_INTERVAL_MS=5000
VIRTUALS_JOB_TIMEOUT_MS=900000
VIRTUALS_OPERATOR_TOKEN=

# Base. Base Sepolia is the safe default; mainnet requires explicit opt-in.
BASE_ENABLED=false
BASE_NETWORK=base-sepolia
BASE_CHAIN_ID=84532
BASE_RPC_URL=https://sepolia.base.org
BASE_RPC_TIMEOUT_MS=10000
BASE_RPC_RETRY_COUNT=2
BASE_PRIVATE_KEY=
BASE_PAYMENT_RECIPIENT=
BASE_PAYMENT_ASSET=ETH
BASE_TOKEN_ADDRESS=
BASE_MAX_PAYMENT_AMOUNT=0.001
BASE_CONFIRMATIONS=1
BASE_OPERATOR_TOKEN=
BASE_ALLOW_MAINNET=false

# Bounded autonomous runner
RUNNER_MAX_RETRIES=2
RUNNER_TIMEOUT_MS=900000
RUNNER_FAILURE_THRESHOLD=3
RUNNER_CANDIDATE_LIMIT=10
