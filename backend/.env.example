# Runtime
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
SHUTDOWN_TIMEOUT_MS=10000
HTTP_HEADERS_TIMEOUT_MS=15000
HTTP_REQUEST_TIMEOUT_MS=30000
HTTP_KEEP_ALIVE_TIMEOUT_MS=5000
# Comma-separated browser origins. Keep empty for same-origin deployment.
CORS_ALLOWED_ORIGINS=
CONTINUITY_OPERATOR_TOKEN=
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120

# PostgreSQL (replace placeholders locally; never commit real credentials)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public

# Optional live integration-test database. Keep unset to skip the live database test.
TEST_DATABASE_URL=

# Sibyl Memory (official stdio MCP server; install with pip install sibyl-memory-mcp)
# MEMORY_ENABLED=false is an explicit non-production deletion-test mode only.
MEMORY_ENABLED=true
SIBYL_MCP_COMMAND=sibyl-memory-mcp
SIBYL_CALL_TIMEOUT_MS=30000
VIRTUALS_ENABLED=false
VIRTUALS_WALLET_ADDRESS=
VIRTUALS_WALLET_ID=
VIRTUALS_SIGNER_PRIVATE_KEY=
VIRTUALS_BUILDER_CODE=
# OAuth is used only by the read-only GET /agents/search discovery client.
# Generate these through `acp configure`; never reuse them for job execution.
VIRTUALS_DISCOVERY_OAUTH_ACCESS_TOKEN=
VIRTUALS_DISCOVERY_OAUTH_REFRESH_TOKEN=
VIRTUALS_DISCOVERY_TIMEOUT_MS=15000
VIRTUALS_CHAIN_ID=8453
VIRTUALS_MAX_JOB_USDC=1
VIRTUALS_POLL_INTERVAL_MS=5000
VIRTUALS_JOB_TIMEOUT_MS=900000
VIRTUALS_OPERATOR_TOKEN=
# Base onchain agent payment (Sepolia by default; never commit the key)
BASE_ENABLED=false
BASE_NETWORK=base-sepolia
BASE_CHAIN_ID=84532
BASE_RPC_URL=https://sepolia.base.org
BASE_RPC_TIMEOUT_MS=10000
BASE_RPC_RETRY_COUNT=2
BASE_PRIVATE_KEY=
BASE_PAYMENT_RECIPIENT=
BASE_PAYMENT_ASSET=ETH
BASE_TOKEN_ADDRESS=
BASE_MAX_PAYMENT_AMOUNT=0.001
BASE_CONFIRMATIONS=1
BASE_OPERATOR_TOKEN=
BASE_ALLOW_MAINNET=false
# Autonomous runner server-side caps. Mission constraints may lower, never raise, these values.
RUNNER_MAX_RETRIES=2
RUNNER_TIMEOUT_MS=900000
RUNNER_FAILURE_THRESHOLD=3
RUNNER_CANDIDATE_LIMIT=10
# Optional official Sibyl path overrides. Credentials are read by Sibyl, never logged.
SIBYL_MEMORY_DB=
SIBYL_CREDENTIALS=
