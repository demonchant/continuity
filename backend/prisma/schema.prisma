generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model BetaSignup {
  id                       String             @id @default(uuid()) @db.Uuid
  email                    String             @unique @db.VarChar(320)
  role                     String             @db.VarChar(50)
  workflow                 String?            @db.Text
  consentToContact         Boolean
  publicAttributionConsent Boolean            @default(false)
  attributionName          String?            @db.VarChar(120)
  status                   String             @default("PENDING") @db.VarChar(20)
  reviewedAt               DateTime?          @db.Timestamptz(3)
  reviewNote               String?            @db.VarChar(500)
  invitations              AccessInvitation[]
  createdAt                DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt                DateTime           @updatedAt @db.Timestamptz(3)

  @@index([createdAt])
}

enum MissionStatus {
  CREATED
  QUEUED
  PLANNING
  SELECTING_AGENT
  EXECUTING
  AWAITING_FUNDING_APPROVAL
  VERIFYING
  AWAITING_BASE_APPROVAL
  COMPLETED
  FAILED
  RECOVERING
  CANCELLED
}

model Mission {
  id                    String                 @id @default(uuid()) @db.Uuid
  objective             String                 @db.Text
  constraints           Json                   @default("{}")
  budget                Decimal                @db.Decimal(20, 8)
  status                MissionStatus          @default(CREATED)
  currentStep           String                 @default("created") @db.VarChar(100)
  transitions           MissionTransition[]
  checkpoint            MissionCheckpoint?
  actions               RecoveryAction[]
  virtualsJobs          VirtualsJob[]
  baseTransactions      BaseTransaction[]
  recoveryAudits        MissionRecoveryAudit[]
  operatorApprovals     OperatorApproval[]
  recoveryState         String?                @db.VarChar(100)
  lastHeartbeat         DateTime?              @db.Timestamptz(3)
  lastReconciliation    DateTime?              @db.Timestamptz(3)
  recoveryFailureReason String?                @db.VarChar(1000)
  organizationId        String?                @db.Uuid
  organization          Organization?          @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  createdAt             DateTime               @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime               @updatedAt @db.Timestamptz(3)

  @@index([status, updatedAt])
  @@index([createdAt, id])
  @@index([organizationId, createdAt])
}

model Organization {
  id                   String               @id @default(uuid()) @db.Uuid
  name                 String               @db.VarChar(120)
  slug                 String               @unique @db.VarChar(80)
  mode                 String               @default("CUSTOMER") @db.VarChar(20)
  spendingEnabled      Boolean              @default(false)
  maximumMissionBudget Decimal              @default(1) @db.Decimal(20, 8)
  maximumAcpJobUsdc    Decimal              @default(1) @db.Decimal(20, 8)
  memberships          OrganizationMember[]
  invitations          AccessInvitation[]
  missions             Mission[]
  sessions             AccessSession[]
  createdAt            DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime             @updatedAt @db.Timestamptz(3)
}

model AccessUser {
  id           String               @id @default(uuid()) @db.Uuid
  email        String               @unique @db.VarChar(320)
  name         String               @db.VarChar(120)
  passwordHash String               @db.VarChar(500)
  status       String               @default("ACTIVE") @db.VarChar(20)
  memberships  OrganizationMember[]
  sessions     AccessSession[]
  createdAt    DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime             @updatedAt @db.Timestamptz(3)
}

model OrganizationMember {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String       @db.Uuid
  user           AccessUser   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           String       @db.VarChar(30)
  createdAt      DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @db.Timestamptz(3)

  @@unique([organizationId, userId])
  @@index([userId])
}

model AccessInvitation {
  id             String       @id @default(uuid()) @db.Uuid
  betaSignupId   String?      @db.Uuid
  betaSignup     BetaSignup?  @relation(fields: [betaSignupId], references: [id], onDelete: SetNull)
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String       @db.VarChar(320)
  role           String       @db.VarChar(30)
  tokenHash      String       @unique @db.VarChar(64)
  status         String       @default("PENDING") @db.VarChar(20)
  expiresAt      DateTime     @db.Timestamptz(3)
  acceptedAt     DateTime?    @db.Timestamptz(3)
  createdAt      DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @db.Timestamptz(3)

  @@index([email, status])
  @@index([betaSignupId])
}

model AccessSession {
  id             String       @id @default(uuid()) @db.Uuid
  userId         String       @db.Uuid
  user           AccessUser   @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tokenHash      String       @unique @db.VarChar(64)
  expiresAt      DateTime     @db.Timestamptz(3)
  revokedAt      DateTime?    @db.Timestamptz(3)
  createdAt      DateTime     @default(now()) @db.Timestamptz(3)

  @@index([userId, expiresAt])
  @@index([organizationId, expiresAt])
  @@index([expiresAt])
}

enum OperatorApprovalKind {
  ACP_FUNDING
  BASE_SETTLEMENT
}

enum OperatorApprovalStatus {
  APPROVED
  CONSUMED
  CANCELLED
}

model OperatorApproval {
  id          String                 @id @default(uuid()) @db.Uuid
  missionId   String                 @db.Uuid
  mission     Mission                @relation(fields: [missionId], references: [id], onDelete: Cascade)
  kind        OperatorApprovalKind
  actionId    String                 @db.VarChar(200)
  referenceId String                 @db.VarChar(300)
  amount      Decimal                @db.Decimal(36, 18)
  currency    String                 @db.VarChar(16)
  status      OperatorApprovalStatus @default(APPROVED)
  approvedAt  DateTime               @default(now()) @db.Timestamptz(3)
  consumedAt  DateTime?              @db.Timestamptz(3)
  createdAt   DateTime               @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime               @updatedAt @db.Timestamptz(3)

  @@unique([missionId, kind, actionId])
  @@index([missionId, status, createdAt])
}

model MissionRecoveryAudit {
  id        String   @id @default(uuid()) @db.Uuid
  missionId String   @db.Uuid
  mission   Mission  @relation(fields: [missionId], references: [id], onDelete: Cascade)
  workerId  String   @db.VarChar(200)
  action    String   @db.VarChar(200)
  status    String   @db.VarChar(50)
  attempt   Int
  details   Json     @default("{}")
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([missionId, createdAt])
  @@index([status, createdAt])
}

model MissionWorkerLease {
  id        String   @id @db.VarChar(100)
  ownerId   String   @db.VarChar(200)
  expiresAt DateTime @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
}

enum BaseTransactionStatus {
  INTENDED
  SUBMITTED
  CONFIRMED
  FAILED
  UNCERTAIN
}

model BaseTransaction {
  id              String                @id @default(uuid()) @db.Uuid
  missionId       String                @db.Uuid
  mission         Mission               @relation(fields: [missionId], references: [id], onDelete: Cascade)
  actionId        String                @db.VarChar(200)
  paymentId       String                @unique @db.VarChar(200)
  agentId         String                @db.VarChar(300)
  transactionHash String?               @unique @db.VarChar(66)
  network         String                @db.VarChar(50)
  chainId         Int
  action          String                @db.VarChar(100)
  verificationId  String?               @db.VarChar(200)
  recipient       String                @db.VarChar(42)
  amount          Decimal               @db.Decimal(36, 18)
  asset           String                @db.VarChar(20)
  status          BaseTransactionStatus @default(INTENDED)
  blockNumber     BigInt?
  confirmations   Int?
  explorerUrl     String?               @db.VarChar(500)
  memoryRecordId  String?               @db.VarChar(200)
  sibylRecordId   String?               @db.VarChar(200)
  sibylEventId    String?               @db.VarChar(200)
  errorCode       String?               @db.VarChar(100)
  errorMessage    String?               @db.VarChar(500)
  createdAt       DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime              @updatedAt @db.Timestamptz(3)
  confirmedAt     DateTime?             @db.Timestamptz(3)

  @@unique([missionId, actionId])
  @@index([missionId, status, updatedAt])
  @@index([missionId, createdAt])
  @@index([verificationId])
}

enum VirtualsJobState {
  CREATED
  OPEN
  BUDGET_PROPOSED
  AWAITING_FUNDING_APPROVAL
  FUNDED
  SUBMITTED
  COMPLETED
  REJECTED
  EXPIRED
  UNCERTAIN
  FAILED
}

model VirtualsJob {
  id              String           @id @default(uuid()) @db.Uuid
  missionId       String           @db.Uuid
  mission         Mission          @relation(fields: [missionId], references: [id], onDelete: Cascade)
  actionId        String           @db.VarChar(200)
  externalJobId   String           @db.VarChar(100)
  chainId         Int
  agentId         String           @db.VarChar(300)
  providerAddress String           @db.VarChar(200)
  offeringName    String           @db.VarChar(300)
  state           VirtualsJobState @default(CREATED)
  requirement     Json
  result          Json?
  verification    Json?
  lifecycle       Json?
  evidenceHash    String?          @db.VarChar(64)
  provenance      Json?
  errorCode       String?          @db.VarChar(100)
  errorMessage    String?          @db.VarChar(500)
  createdAt       DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime         @updatedAt @db.Timestamptz(3)
  completedAt     DateTime?        @db.Timestamptz(3)

  @@unique([missionId, actionId])
  @@unique([chainId, externalJobId])
  @@index([missionId, state, updatedAt])
  @@index([missionId, createdAt])
  @@index([evidenceHash])
}

model VirtualsDiscoveryCredential {
  id                   String    @id @db.VarChar(100)
  ciphertext           Bytes
  iv                   Bytes
  authenticationTag    Bytes
  encryptionVersion    Int
  revision             Int       @default(1)
  accessTokenExpiresAt DateTime? @db.Timestamptz(3)
  createdAt            DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime  @updatedAt @db.Timestamptz(3)
}

enum RecoveryActionStatus {
  INTENDED
  IN_PROGRESS
  COMPLETED
  FAILED
  UNCERTAIN
}

model MissionCheckpoint {
  missionId         String        @id @db.Uuid
  mission           Mission       @relation(fields: [missionId], references: [id], onDelete: Cascade)
  missionState      MissionStatus
  currentStep       String        @db.VarChar(100)
  selectedAgentId   String?       @db.VarChar(200)
  actionState       Json
  paymentState      Json
  verificationState Json
  recoveryInfo      Json
  nextAction        String        @db.VarChar(200)
  version           Int           @default(1)
  createdAt         DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime      @updatedAt @db.Timestamptz(3)

  @@index([missionState, updatedAt])
}

model RecoveryAction {
  id                String               @id @default(uuid()) @db.Uuid
  missionId         String               @db.Uuid
  mission           Mission              @relation(fields: [missionId], references: [id], onDelete: Cascade)
  actionId          String               @db.VarChar(200)
  paymentId         String?              @unique @db.VarChar(200)
  kind              String               @db.VarChar(100)
  status            RecoveryActionStatus @default(INTENDED)
  attempts          Int                  @default(0)
  providerReference String?              @db.VarChar(500)
  receipt           Json?
  failureReason     String?              @db.VarChar(1000)
  createdAt         DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime             @updatedAt @db.Timestamptz(3)
  completedAt       DateTime?            @db.Timestamptz(3)

  @@unique([missionId, actionId])
  @@index([missionId, status, updatedAt])
  @@index([missionId, createdAt])
}

model MissionTransition {
  id         String         @id @default(uuid()) @db.Uuid
  missionId  String         @db.Uuid
  mission    Mission        @relation(fields: [missionId], references: [id], onDelete: Cascade)
  fromStatus MissionStatus?
  toStatus   MissionStatus
  reason     String?        @db.VarChar(500)
  createdAt  DateTime       @default(now()) @db.Timestamptz(3)

  @@index([missionId, createdAt])
}
